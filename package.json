{
  "name": "my-nav",
  "type": "module",
  "version": "0.0.1",
  "homepage": "https://san-ren.github.io/",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "start:dev": "astro dev",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "//说明": "👇 DEPLOY_TARGET 决定构建目标，请勿手工改 astro.config.mjs 里的 base",
    "build": "cross-env DEPLOY_TARGET=github astro build",
    "build:gh": "cross-env DEPLOY_TARGET=github astro build",
    "build:root": "cross-env DEPLOY_TARGET=root astro build",
    "build:admin": "cross-env DEPLOY_TARGET=admin astro build",
    "serve:admin": "cross-env DEPLOY_TARGET=admin astro build && node ./dist/server/entry.mjs",
    "//说明2": "👇 补全平台探测缓存（手动 platforms 字段优先，未填写的 GitHub 资源走这里兜底）",
    "platforms:detect": "node src/utils/platformDetect.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdoc": "^2.0.9",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@keystatic/astro": "^5.0.6",
    "@keystatic/core": "^0.5.50",
    "astro": "7.3.5",
    "astro-expressive-code": "^0.41.7",
    "astro-seo": "^1.1.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "fuse.js": "^7.3.0",
    "glob": "^13.0.6",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "stylus": "^0.64.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "cross-env": "^10.1.0"
  }
}
